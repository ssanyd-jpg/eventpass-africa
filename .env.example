# The schema is Postgres-only (see prisma/schema.prisma) — local dev needs a
# real Postgres database too, e.g. a free Neon project. See DEPLOYMENT.md.
DATABASE_URL="<Neon pooled connection string>"
DIRECT_URL="<Neon direct/unpooled connection string>"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Required to run `npm test` — a SEPARATE, disposable Postgres database
# (e.g. a dedicated Neon branch). Tests run `prisma db push --accept-data-loss`
# against this on every run, so it must never point at DATABASE_URL above.
TEST_DATABASE_URL="<a different Postgres connection string, dedicated to tests>"

# --- Optional integrations — the app runs fully without these ---
# BLOB_READ_WRITE_TOKEN=          # real event photo uploads (Vercel Blob)
# RESEND_API_KEY=                 # real email delivery
# AFRICASTALKING_API_KEY=         # real SMS delivery
# Airpay Tanzania — real mobile money charging (not yet wired into checkout — see README).
# All seven must be set for airpayProvider to activate; get these from Airpay after merchant signup.
# AIRPAY_MERCHANT_ID=
# AIRPAY_CLIENT_ID=
# AIRPAY_CLIENT_SECRET=
# AIRPAY_USERNAME=
# AIRPAY_PASSWORD=
# AIRPAY_SECRET=
# AIRPAY_MERCHANT_DOMAIN=         # e.g. https://your-app.vercel.app
