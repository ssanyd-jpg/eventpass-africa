# The schema is Postgres-only (see prisma/schema.prisma) — local dev needs a
# real Postgres database too, e.g. a free Neon project. See DEPLOYMENT.md.
DATABASE_URL="<Neon pooled connection string>"
DIRECT_URL="<Neon direct/unpooled connection string>"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Required to run `npm test` — a SEPARATE, disposable Postgres database
# (e.g. a dedicated Neon branch). Tests run `prisma db push --accept-data-loss`
# against this on every run, so it must never point at DATABASE_URL above.
TEST_DATABASE_URL="<a different Postgres connection string, dedicated to tests>"

# --- Optional integrations — the app runs fully without these ---
# BLOB_READ_WRITE_TOKEN=          # real event photo uploads (Vercel Blob)
# RESEND_API_KEY=                 # real email delivery — see src/lib/email.ts
# CHAAP_FROM_EMAIL=               # sender address for real email (default: noreply@chaap-africa.com)
# AT_API_KEY=                     # Africa's Talking API key — real SMS delivery, see src/lib/sms.ts
# AT_USERNAME=                    # Africa's Talking username (both AT_ vars required together)
# AT_WHATSAPP_USERNAME=           # Africa's Talking WhatsApp product username — see src/lib/whatsapp.ts
# AT_WHATSAPP_SHORTCODE=          # The WhatsApp Business number (waNumber) registered to that product
#                                  # All three AT_WHATSAPP_USERNAME/AT_WHATSAPP_SHORTCODE + AT_API_KEY are
#                                  # required together; without them, WhatsApp sends fall back to SMS (or
#                                  # to a console log if AT_API_KEY/AT_USERNAME are also unset). As of this
#                                  # writing Africa's Talking's WhatsApp *sandbox* endpoint is listed as
#                                  # "coming soon" — only the live endpoint works — so local dev is expected
#                                  # to run on the SMS/log fallback until this goes to production.
# CRON_SECRET=                    # Bearer token Vercel Cron sends to /api/cron/reminders — generate with openssl rand -base64 32
# ANTHROPIC_API_KEY=              # AI-assisted descriptions / support drafts / survey summaries (Claude)
# Airpay Tanzania — real mobile money charging (not yet wired into checkout — see README).
# All seven must be set for airpayProvider to activate; get these from Airpay after merchant signup.
# AIRPAY_MERCHANT_ID=
# AIRPAY_CLIENT_ID=
# AIRPAY_CLIENT_SECRET=
# AIRPAY_USERNAME=
# AIRPAY_PASSWORD=
# AIRPAY_SECRET=
# AIRPAY_MERCHANT_DOMAIN=         # e.g. https://your-app.vercel.app
