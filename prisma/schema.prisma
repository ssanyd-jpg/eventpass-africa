generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// role is USER | ADMIN — a platform-wide flag (ADMIN only gates the /admin
// moderation panel). This is unrelated to OrganizationMembership.role
// (OWNER | STAFF), which governs what a user can do within their org.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationMembership OrganizationMembership?
  sentInvites            OrganizationInvite[]     @relation("InvitedBy")
  orders                 Order[]
  passwordResetTokens    PasswordResetToken[]
  vendorApplications     Vendor[]
  wallets                Wallet[]
  userSessions           UserSession[]
  ticketTransfersSent    TicketTransfer[]         @relation("TicketTransfersSent")
}

// Every user belongs to exactly one organization, always — registration
// auto-creates a personal one (see createPersonalOrganization in
// src/lib/organizations.ts). This keeps the offline-first CREATE_EVENT flow
// simple (the client always has a cached organizationId) and avoids
// nullable-org branching throughout the session/auth code.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membership          OrganizationMembership[]
  invites             OrganizationInvite[]
  events              Event[]
  mobileMoneyAccounts MobileMoneyAccount[]
  settlements         Settlement[]
  auditLogs           AuditLog[]
  devices             Device[]
  customerNotes       CustomerNote[]
  broadcasts          Broadcast[]
  credentials         Credential[]
  supportTickets      SupportTicket[]
}

// action is a closed set of accountability events for actions an
// organization's own members take (event/vendor/settlement/team changes)
// — see AuditAction in src/lib/audit.ts. Deliberately excludes personal/
// attendee actions (buying tickets, applying to vendor), gate-scan
// check-ins (too high-frequency for an accountability trail), and
// platform-admin moderation actions (a different actor namespace — an
// admin isn't a member of the org they're moderating). actorName is a
// denormalized snapshot, same discipline as Order.currency/Vendor's fee
// snapshot, so the list page never needs a join to render.
model AuditLog {
  id             String   @id @default(cuid())
  action         String
  summary        String
  actorUserId    String
  actorName      String
  createdAt      DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Device registry for offline-first gate-scanning installs. deviceId is a
// client-generated persistent UUID (see getOrCreateDeviceId in src/lib/db.ts)
// — NOT the same thing as clientId (a per-operation idempotency key, see
// newLocalId()). Scoped per-organization, not globally, matching every other
// org-scoped model (Sponsor/Vendor/MobileMoneyAccount) — the same physical
// phone could be used across two orgs over its lifetime; revocation should
// only ever mean "cut this device off from OUR org."
model Device {
  id               String    @id @default(cuid())
  deviceId         String
  label            String    @default("")
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  lastSeenByUserId String
  lastSeenByName   String
  revokedAt        DateTime?
  revokedByUserId  String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, deviceId])
}

// Append-only, org-scoped commentary about a ticket buyer. customerUserId is
// a plain string, not a relation — same discipline as AuditLog.actorUserId/
// Device.lastSeenByUserId: User is a platform-wide account with no org
// ownership of its own, so this must never cascade with the User row.
model CustomerNote {
  id             String   @id @default(cuid())
  body           String
  createdAt      DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerUserId String
  authorUserId   String
  authorName     String

  @@index([organizationId, customerUserId, createdAt])
}

// Records one broadcast-send event, org-scoped. NotificationLog itself has
// no organizationId/userId (flat, platform-wide) so it can't be the
// organizer-facing record of "I sent this"; each recipient's actual
// delivery still goes through the unmodified sendNotification(), producing
// its usual unscoped NotificationLog row exactly as every other send today.
model Broadcast {
  id             String   @id @default(cuid())
  subject        String
  body           String
  recipientCount Int
  createdAt      DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  ticketTypeId String?
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])

  sentByUserId String
  sentByName   String

  @@index([organizationId, createdAt])
}

// status is OPEN | RESOLVED (plain-string convention). buyerUserId is a
// plain string, not a relation — same discipline as CustomerNote.customerUserId
// (User has no org ownership of its own). Any signed-in user may open a
// ticket about an event, not just an existing customer — the opposite
// trust direction from CustomerNote's organizer-authored-about-an-actual-
// customer guard (addCustomerNoteById requires a prior order; this doesn't,
// deliberately — several places in the app already promise "contact the
// organizer" to any visitor, not just past buyers).
model SupportTicket {
  id        String   @id @default(cuid())
  subject   String
  body      String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI-suggested classification — computed on-demand (organizer clicks
  // "Suggest"), never automatically on ticket creation. Null means "not yet
  // suggested," not "no category applies." aiCategory is a closed set
  // ("Billing"|"Access/Tickets"|"Event Info"|"Technical"|"Other") and
  // aiPriority is "LOW"|"MEDIUM"|"HIGH" — both plain strings per this
  // codebase's no-native-enums convention, validated at the call site
  // (src/lib/ai/support-assist.ts), not by the DB.
  aiCategory String?
  aiPriority String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  buyerUserId String

  replies SupportTicketReply[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, buyerUserId])
}

// Append-only reply thread — same "the timeline itself is the record"
// discipline as CustomerNote, extended to two directions (isFromOrganizer
// distinguishes the buyer's own messages from the organizer's replies).
model SupportTicketReply {
  id              String   @id @default(cuid())
  body            String
  authorUserId    String
  authorName      String
  isFromOrganizer Boolean
  createdAt       DateTime @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// Pure audit/history trail for Ticket.code / Wallet.code / Vendor.badgeCode
// replacement — NEVER read in the hot scan/charge lookup path (handleCheckIn/
// handleCheckInVendor/handleChargeWallet/handleSponsorTap keep doing
// findUnique({where:{code}}) against Ticket/Wallet/Vendor directly, unchanged).
// Exactly one of ticketId/walletId/vendorId is set per row — same nullable-
// triple convention as WalletTransaction.vendorId/sponsorId, extended by one.
// No backfill: an entity with zero Credential rows simply means "still on its
// original code, never replaced" — same reasoning as Device/CustomerNote.
// status is ACTIVE | SUPERSEDED (plain-string convention) — not a separate
// terminal LOST state: marking something lost is atomic with issuing the
// replacement, so a row transitions ACTIVE -> SUPERSEDED at the same moment a
// new ACTIVE row is created. No self-relation pointer needed —
// Credential.findMany({where:{ticketId}, orderBy:{createdAt:"asc"}}) gives the
// full ordered chain without one.
model Credential {
  id                 String    @id @default(cuid())
  code               String
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  createdByUserId    String
  createdByName      String
  supersededAt       DateTime?
  supersededByUserId String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: Cascade)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([organizationId, ticketId])
  @@index([organizationId, walletId])
  @@index([organizationId, vendorId])
}

// type is TEXT | SELECT | CHECKBOX (plain-string convention — see
// MobileMoneyAccount.provider). options is a comma-joined string, SELECT only
// — no separate option-row model: like TicketType, this data has no
// independent lifecycle of its own, so a child table is pure indirection.
// Never deleted server-side once referenced — mirrors handleEditEvent's
// ticketTypes sub-pattern exactly: removing a question from the organizer's
// form just stops sending it, it isn't explicitly dropped.
model RegistrationQuestion {
  id        String   @id @default(cuid())
  clientId  String?  @unique
  label     String
  type      String   // TEXT | SELECT | CHECKBOX
  options   String?  // comma-joined, SELECT only, e.g. "Small,Medium,Large"
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  answers RegistrationAnswer[]
}

// One row per question per order — not a JSON blob. This schema has zero
// Json-typed columns anywhere; Order already decomposes into one-row-per-item
// children (OrderItem, Ticket) rather than a blob, so this keeps the same
// shape discipline.
model RegistrationAnswer {
  id        String   @id @default(cuid())
  value     String
  createdAt DateTime @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  questionId String
  question   RegistrationQuestion @relation(fields: [questionId], references: [id])

  @@index([orderId])
}

// Organizer-defined, per event, post-event only — same TEXT | SELECT |
// CHECKBOX plain-string shape and never-delete convention as
// RegistrationQuestion (this is deliberately the same field set, not a
// coincidence: it rides inside the same EDIT_EVENT op and reuses the exact
// zod schema — see registrationQuestionInputSchema in sync-handlers.ts).
// Kept out of the public `events` pull payload (unlike RegistrationQuestion,
// which anonymous checkout needs pre-purchase) — survey questions are never
// needed before a ticket is bought, same reasoning as DiscountCode.
model SurveyQuestion {
  id        String   @id @default(cuid())
  clientId  String?  @unique
  label     String
  type      String   // TEXT | SELECT | CHECKBOX
  options   String?  // comma-joined, SELECT only
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  responses SurveyResponse[]
}

// One row per question per buyer — not per order (a buyer with multiple
// orders for the same event answers the survey once, not once per order,
// unlike RegistrationAnswer which is inherently per-order/pre-purchase).
model SurveyResponse {
  id        String   @id @default(cuid())
  value     String
  createdAt DateTime @default(now())

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  buyerUserId String

  @@unique([questionId, buyerUserId])
}

// role is OWNER | STAFF | GATE_CREW (plain-string convention — see
// MobileMoneyAccount.provider). @@unique([userId]), not
// @@unique([organizationId, userId]) — that's the v1 "one org per user"
// scope cut: a user can never belong to two organizations at once.
model OrganizationMembership {
  id        String   @id @default(cuid())
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Same hashed-token + expiry shape as PasswordResetToken. status is
// PENDING | ACCEPTED | REVOKED. role is STAFF | GATE_CREW — never OWNER
// (no promote-to-owner-via-invite, and no role-change UI after acceptance).
model OrganizationInvite {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  email      String
  role       String    @default("STAFF")
  status     String    @default("PENDING")
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedBy       User   @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tracks one row per successful credential login. Deliberately unrelated to
// Device (see below) — Device is a per-org-per-browser install that survives
// logout and is shared by whoever's signed in; UserSession is per-login and
// ends at logout/revocation. id is echoed into the JWT as token.sessionId
// once, at initial sign-in (see auth.ts authorize()), and is the only thing
// a self-service revoke may target.
model UserSession {
  id              String    @id @default(cuid())
  label           String
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  revokedAt       DateTime?
  revokedByUserId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// type is PERCENT_OFF | FIXED_AMOUNT_OFF (plain-string convention). Exactly
// one of percentOff/amountOffCents is set, matching type — enforced in
// handleEditEvent, not the DB. Always scoped to exactly one ticket type
// (never the whole order — a deliberate v1 scope decision). code is stored
// uppercased/trimmed, unique per-event (not globally — organizers commonly
// want e.g. "EARLYBIRD" available across many of their own events). Never
// deleted server-side — same never-delete discipline as ticketTypes/
// registrationQuestions; "deactivate" just flips active to false.
model DiscountCode {
  id              String    @id @default(cuid())
  clientId        String?   @unique
  code            String
  type            String    // PERCENT_OFF | FIXED_AMOUNT_OFF
  percentOff      Int?
  amountOffCents  Int?
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  orders Order[]

  @@unique([eventId, code])
}

// status is PENDING | ACCEPTED | EXPIRED | CANCELLED (plain-string
// convention). Hashed-token + expiry shape mirrors OrganizationInvite.
// Unlike OrganizationInvite, this supports cancellation — a buyer who
// mistypes an email needs recourse in a way a rare org-teammate invite
// doesn't (an uncancellable pending transfer would otherwise freeze that
// ticket's "who holds this" state for 7 days with nobody notified anything
// is wrong).
model TicketTransfer {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  toEmail          String
  status           String    @default("PENDING")
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime  @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("TicketTransfersSent", fields: [fromUserId], references: [id], onDelete: Cascade)
}

// provider is one of: MPESA_TZ | TIGO_PESA | AIRTEL_MONEY | HALOPESA
// (plain string rather than a Postgres enum, to keep adding a new provider
// a data change instead of a migration)
model MobileMoneyAccount {
  id          String   @id @default(cuid())
  provider    String
  phoneNumber String
  accountName String
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  settlements Settlement[]
}

model Settlement {
  id                String   @id @default(cuid())
  periodStart       DateTime
  periodEnd         DateTime
  // A settlement only ever covers orders in one currency — runSettlement
  // groups an organization's unsettled orders by currency and creates one
  // settlement per group, so this never mixes amounts across currencies.
  currency          String   @default("TZS")
  grossCents        Int
  platformFeeCents  Int
  netCents          Int
  status            String   @default("PENDING")
  payoutReference   String?
  createdAt         DateTime @default(now())
  paidAt            DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  mobileMoneyAccountId String
  mobileMoneyAccount   MobileMoneyAccount @relation(fields: [mobileMoneyAccountId], references: [id])

  items SettlementItem[]
}

model SettlementItem {
  id          String @id @default(cuid())
  amountCents Int

  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
}

// status is LIVE | CANCELLED. Cancelled events are hidden from public
// browse but stay visible (badged) to the organization and existing ticket
// holders.
model Event {
  id          String   @id @default(cuid())
  clientId    String?  @unique
  slug        String   @unique
  title       String
  description String
  category    String
  venue       String
  city        String
  startsAt    DateTime
  imageUrl    String
  status      String   @default("LIVE")
  // ISO 4217 code. All ticket types on an event share its currency — see
  // CURRENCIES in src/lib/currency.ts for the supported set.
  currency    String   @default("TZS")
  // 0 means no fee — vendors can still apply/be added, just with feeStatus NONE.
  vendorApplicationsOpen Boolean @default(false)
  vendorStallFeeCents    Int     @default(0)
  // null = no waiver required for this event. Live, organizer-editable copy —
  // Order.waiverText snapshots the exact text a given buyer saw/agreed to at
  // purchase time, same reasoning Order.currency snapshots Event.currency.
  waiverText  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  ticketTypes           TicketType[]
  orders                Order[]
  tickets               Ticket[]
  vendors               Vendor[]
  sponsors              Sponsor[]
  wallets               Wallet[]
  broadcasts            Broadcast[]
  registrationQuestions RegistrationQuestion[]
  discountCodes         DiscountCode[]
  supportTickets        SupportTicket[]
  surveyQuestions       SurveyQuestion[]
}

model TicketType {
  id            String   @id @default(cuid())
  clientId      String?  @unique
  name          String
  description   String   @default("")
  priceCents    Int
  quantityTotal Int
  quantitySold  Int      @default(0)
  updatedAt     DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  orderItems    OrderItem[]
  tickets       Ticket[]
  broadcasts    Broadcast[]
  discountCodes DiscountCode[]
}

model Order {
  id         String   @id @default(cuid())
  clientId   String?  @unique
  status     String   @default("PAID")
  totalCents Int
  // Snapshot of the event's currency at purchase time (events can't change
  // currency once they have sales — see handleEditEvent).
  currency   String   @default("TZS")
  // Snapshot of Event.waiverText at purchase time — same "don't let a later
  // event edit change what a past buyer is shown as having agreed to"
  // discipline as currency/Vendor.stallFeeCents snapshotting Event fields.
  // null when the event had no waiver at purchase time.
  waiverText       String?
  waiverAcceptedAt DateTime?
  // Snapshot discipline, same as currency/waiverText above: discountCodeText/
  // discountTicketTypeName record what was actually applied at purchase
  // time, so a later code edit/deactivation never changes a past receipt.
  // discountCodeId is nullable and SET NULL on delete — but per the
  // never-delete convention DiscountCode rows are never actually removed,
  // so in practice this stays populated whenever a code was applied.
  discountCodeId         String?
  discountCode            DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountCodeText        String?
  discountTicketTypeName  String?
  discountCents            Int      @default(0)
  // Airpay real-payment collection (status can also be "PENDING" awaiting
  // STK-push confirmation, or "PAYMENT_FAILED" if declined/timed out —
  // mirrors WalletTransaction.providerReference/providerMessage below).
  // paymentMethod is "AIRPAY_ONLINE" | "OFFLINE_DEFERRED" | null (legacy/
  // unspecified — an order created before this feature, or by a client
  // that didn't opt into either path).
  providerReference String?
  providerMessage   String?
  paymentMethod     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  items               OrderItem[]
  tickets             Ticket[]
  settlementItems     SettlementItem[]
  registrationAnswers RegistrationAnswer[]
}

model OrderItem {
  id            String @id @default(cuid())
  quantity      Int
  unitPriceCents Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  bucketKey String
  createdAt DateTime @default(now())

  @@index([bucketKey, createdAt])
}

// channel is EMAIL | SMS. status is LOGGED (no provider configured — visible
// in /admin for manual relay during the pilot) | SENT | FAILED.
model NotificationLog {
  id        String   @id @default(cuid())
  type      String
  channel   String
  recipient String
  subject   String
  body      String
  status    String   @default("LOGGED")
  createdAt DateTime @default(now())
}

model Ticket {
  id          String    @id @default(cuid())
  clientId    String?   @unique
  code        String    @unique
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?
  // null = holder is the original buyer (order.userId). Set only by an
  // ACCEPTED TicketTransfer. Does NOT gate check-in — handleCheckIn only
  // ever checks ticket.code + scanning org; this field is purely about
  // whose account the ticket shows up in, never an access-control change
  // (anyone holding the code could already check in today regardless of
  // transfer).
  currentHolderUserId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  credentials Credential[]
  transfers   TicketTransfer[]
}

// status is PENDING | APPROVED | REJECTED. feeStatus is NONE | PAID | REFUNDED
// (plain-string "enum" convention — see MobileMoneyAccount.provider).
// stallFeeCents/currency snapshot Event.vendorStallFeeCents/currency at
// application time, same reasoning as Order.currency snapshotting Event.currency.
model Vendor {
  id            String    @id @default(cuid())
  clientId      String?   @unique
  name          String
  category      String // Food | Merchandise | Services | Other
  description   String    @default("")
  contactEmail  String    @default("")
  contactPhone  String    @default("")
  status        String    @default("PENDING")
  boothNumber   String?
  stallFeeCents Int       @default(0)
  currency      String    @default("TZS")
  feeStatus     String    @default("NONE")
  badgeCode     String?   @unique
  checkedIn     Boolean   @default(false)
  checkedInAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  ownerUserId String?
  owner       User?   @relation(fields: [ownerUserId], references: [id])

  walletSales WalletTransaction[]
  credentials Credential[]
}

// Organizer-managed sponsor entity — same shape as Vendor, simplified: no
// ownerUserId/self-apply (no sponsor login/portal), no status
// PENDING/APPROVED/REJECTED (every sponsor an organizer adds is immediately
// active), no badgeCode/checkedIn (no sponsor check-in flow). feeCents is
// real client-supplied input (not derived from the event, unlike Vendor's
// stallFeeCents) — sponsorship fees are inherently variable per sponsor,
// and this is the organizer's own number for their own reporting, not
// charged to anyone.
model Sponsor {
  id           String   @id @default(cuid())
  clientId     String?  @unique
  name         String
  tier         String // Platinum | Gold | Silver | Bronze | Other
  description  String   @default("")
  contactEmail String   @default("")
  contactPhone String   @default("")
  feeCents     Int      @default(0)
  currency     String   @default("TZS")
  feeStatus    String   @default("NONE") // NONE | PAID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  sponsorTaps      WalletTransaction[]
  sponsorCampaigns SponsorCampaign[]
}

// A sponsor-booth coupon/giveaway — NOT a ticket-price discount (see
// DiscountCode). Redeeming one gets an attendee something off-platform: a
// sample, a raffle entry, a prize — no monetary amount to apply, so no
// percentOff/amountOffCents. Scoped to one sponsor, not the whole event:
// code is unique per-sponsor, not per-event, since two independent
// sponsors may each want "FREE" or "SAMPLE". Never deleted server-side —
// same discipline as DiscountCode; "deactivate" flips active to false.
model SponsorCampaign {
  id              String    @id @default(cuid())
  clientId        String?   @unique
  name            String
  code            String
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sponsorId String
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  redemptions WalletTransaction[]

  @@unique([sponsorId, code])
}

// One wallet per user per event (v1 scope cut — no multi-wristband/family
// sharing). currency snapshots Event.currency at creation, same discipline
// as Order.currency/Vendor.currency.
model Wallet {
  id           String   @id @default(cuid())
  clientId     String?  @unique
  code         String   @unique // generateTicketCode() — same generator Ticket.code/Vendor.badgeCode already reuse
  balanceCents Int      @default(0)
  currency     String   @default("TZS")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id])

  transactions WalletTransaction[]
  credentials  Credential[]

  @@unique([eventId, ownerUserId])
}

// type is TOPUP | SALE | SPONSOR_TAP. status is PENDING | COMPLETED | FAILED
// (plain-string convention — see MobileMoneyAccount.provider). Only TOPUP is
// ever PENDING (waiting on an async mobile-money charge); SALE/SPONSOR_TAP
// always resolve synchronously.
model WalletTransaction {
  id                String   @id @default(cuid())
  clientId          String?  @unique
  type              String
  status            String   @default("COMPLETED")
  amountCents       Int?     // null only for SPONSOR_TAP
  currency          String   @default("TZS")
  providerReference String?  // aggregator's merchant order id, for reconciliation
  providerMessage   String?
  phoneNumber       String?  // TOPUP and WITHDRAWAL
  // WITHDRAWAL only — no real disbursement API exists, so the organizer
  // pays the buyer out manually (mobile money/cash) after approving the
  // request; they need to know which network to use. TOPUP's payload has
  // long accepted a mobileNetwork too but never persisted it — out of
  // scope here to retrofit that.
  mobileNetwork     String?
  // Freeform note a staff member can type at SPONSOR_TAP scan time (e.g.
  // "interested in the Series A demo") — always null for TOPUP/SALE. No
  // attendee-facing consent step: a tap already silently links to the
  // attendee's account for analytics today (see sponsorTapsBySponsor in
  // src/lib/analytics.ts); this field just makes that existing link
  // visible/exportable to the organizer, deliberately matching that same
  // posture rather than adding new linkage — a considered choice, not an
  // oversight (see the Sponsors lead-capture plan).
  note              String?  // SPONSOR_TAP only
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  vendorId String? // SALE only
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  sponsorId String? // SPONSOR_TAP only
  sponsor   Sponsor? @relation(fields: [sponsorId], references: [id])

  // SPONSOR_TAP only — set iff this tap redeemed a SponsorCampaign; null
  // means a plain lead-capture tap. Postgres treats NULL as distinct in a
  // unique index, so @@unique([campaignId, walletId]) only binds rows that
  // share a real (campaignId, walletId) pair — every existing/plain tap is
  // untouched by this constraint.
  campaignId String?
  campaign   SponsorCampaign? @relation(fields: [campaignId], references: [id])

  @@index([sponsorId, type, createdAt])
  @@unique([campaignId, walletId])
}
